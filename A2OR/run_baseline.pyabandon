"""Run the A2 official v0.1-N baseline with a 6 GiB PyTorch GPU memory cap."""

import os
import sys
from pathlib import Path

import torch


GPU_INDEX = 0
#GPU_MEMORY_LIMIT_GIB = 6
WORKSPACE = Path(__file__).resolve().parents[1]
os.environ.setdefault("YOLO_CONFIG_DIR", str(WORKSPACE / "A2OR/.ultralytics"))
sys.path.insert(0, str(WORKSPACE))


def main():
    """Apply the memory cap before importing Ultralytics, then train the baseline."""
    if not torch.cuda.is_available():
        raise RuntimeError("CUDA is required for the requested 6 GiB GPU-memory-capped baseline run.")

    total_memory = torch.cuda.get_device_properties(GPU_INDEX).total_memory
    #memory_fraction = GPU_MEMORY_LIMIT_GIB * 1024**3 / total_memory
    #torch.cuda.set_per_process_memory_fraction(memory_fraction, GPU_INDEX)
    # print(
    #     f"GPU {GPU_INDEX} memory cap: {GPU_MEMORY_LIMIT_GIB} GiB "
    #     f"({memory_fraction:.6f} of {total_memory / 1024**3:.3f} GiB total)",
    #     flush=True,
    # )

    from ultralytics import YOLO

    model = YOLO(WORKSPACE / "ultralytics/cfg/models/master/v0_1/det/yolo-master-n.yaml")
    if "--preflight" in sys.argv:
        print("Preflight succeeded: model and GPU memory cap are ready.", flush=True)
        return

    model.train(
        data=WORKSPACE / "A2OR/visdrone_full.yaml",
        epochs=120,
        patience=0,
        batch=4,
        workers=0,
        imgsz=800,
        device=GPU_INDEX,
        val=True,
        split="val",
        fraction=1.0,
        project=WORKSPACE / "A2OR/runs",
        name="baseline",
    )


if __name__ == "__main__":
    main()
